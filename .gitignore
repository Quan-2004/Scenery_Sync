# ══════════════════════════════════════════════════
# Scenery Sync — .gitignore
# ══════════════════════════════════════════════════

# ── Secrets & API Keys ─────────────────────────────
.env
.env.local
.env.*.local
.env.*.local.json
.env.local.json
google-services.json
GoogleService-Info.plist

# ── Flutter / Dart / Pub ───────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json

# ── Android build artifacts ────────────────────────
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/android/local.properties
/android/captures/
*.apk
*.aab
*.keystore
*.jks

# ── iOS build artifacts ────────────────────────────
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
*.ipa
*.dSYM.zip
*.dSYM

# ── macOS ──────────────────────────────────────────
/macos/Flutter/GeneratedPluginRegistrant.swift
/macos/Flutter/ephemeral/

# ── Web / Next.js (landing-nextjs & admin-web) ─────
node_modules/
.next/
out/
.netlify/
package-lock.json

# ── Large static files in web/ ─────────────────────
/web/*.apk
/web/*.aab
/web/latest-release.json

# ── IDE & Editor ───────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# ── OS files ───────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs & temp ────────────────────────────────────
*.log
*.class
*.pyc
.buildlog/
.history
.svn/
.atom/
.swiftpm/
migrate_working_dir/

# ── Firebase local cache ───────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ── Documentation (generated by AI agents) ─────────
agent.md
.agent.md